; Direct GitHub Releases times out on this machine; the Huawei mirror is the fast path.
; npm 10 still forwards unknown keys to install scripts as npm_config_<key>;
; set ELECTRON_MIRROR in the environment as well if a future npm drops that.
electron_mirror=https://mirrors.huaweicloud.com/electron/

; Nothing here ever launches a browser: the only Playwright entry point is
; connectOverCDP against the shell. Skip the (large) browser download.
playwright_skip_browser_download=1
